generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  AMBULANCE_PROVIDER
  SUPPORT_AGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum ExperienceLevel {
  LESS_THAN_ONE
  ONE_TO_FIVE
  FIVE_PLUS
}

enum AmbulanceRequestStatus {
  REQUESTED
  ACCEPTED
  DISPATCHED
  ARRIVED
  COMPLETED
  CANCELED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  BILLING_AND_PAYMENTS
  TECHNICAL_ISSUE
  APPOINTMENT_PROBLEM
  AMBULANCE_ISSUE
  ACCOUNT_VERIFICATION
  PRESCRIPTION_ISSUE
  GENERAL_INQUIRY
  OTHER
}

model Account {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  firstName         String?
  lastName          String?
  age               Int?
  phone             String?
  address           String?
  city              String?
  zipCode           String?
  role              Role
  isProfileCompleted Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  doctor  Doctor?
  patient Patient?
  ambulanceProvider AmbulanceProvider?

  ticketsCreated    SupportTicket[]  @relation("TicketsCreated")
  ticketsAssigned   SupportTicket[]  @relation("TicketsAssigned")
  supportMessages   SupportMessage[]
}

model Doctor {
  id              String          @id @default(cuid())
  accountId       String          @unique
  account         Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  photoUrl        String?
  description     String?
  approvalStatus  ApprovalStatus  @default(PENDING)
  hospital        String?
  specialty       String?
  price           Float?
  degrees         String[]
  certifications  String[]
  schedule        Json?
  experienceLevel ExperienceLevel?

  consultations   Consultation[]
  payments        Payment[]
  blogPosts       BlogPost[]
  reviews         Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id                    String   @id @default(cuid())
  accountId             String   @unique
  account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  weight                Float?
  height                Float?
  gender                Gender?
  bloodType             BloodType?
  allergies             String[]
  chronicConditions     String[]
  currentMedications    String[]
  emergencyContactName  String?
  emergencyContactPhone String?

  consultations Consultation[]
  payments      Payment[]
  ambulanceRequests  AmbulanceRequest[]
  reviews            Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Consultation {
  id        String              @id @default(cuid())
  date      DateTime
  status    ConsultationStatus  @default(PENDING)
  notes     String?

  doctorId  String
  doctor    Doctor              @relation(fields: [doctorId], references: [id])

  patientId String
  patient   Patient             @relation(fields: [patientId], references: [id])

  payment   Payment?
  review    Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id                String        @id @default(cuid())
  checkoutSessionId String        @unique
  paymentIntentId   String?
  amount            Float
  currency          String        @default("usd")
  status            PaymentStatus @default(PENDING)

  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  consultationId String?       @unique
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id             String   @id @default(cuid())
  rating         Int
  comment        String?

  consultationId String   @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id])

  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medicine {
  id                    String   @id @default(cuid())
  brandName             String
  genericName           String
  form                  String
  therapeuticCategory   String
  manufacturer          String
  strength              String
  unit                  String
  price                 Float
  prescriptionRequired  Boolean  @default(false)
  description           String
  dosage                String
  sideEffects           String
  imageUrl              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  coverImageUrl String?
  excerpt       String?
  content       String
  category      String
  readTimeMinutes Int      @default(1)
  status        BlogStatus @default(DRAFT)
  rejectionReason String?

  doctorId      String
  doctor        Doctor     @relation(fields: [doctorId], references: [id])

  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model AmbulanceProvider {
  id               String         @id @default(cuid())
  accountId        String         @unique
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  organizationName String?
  vehicleInfo      String?
  serviceArea      String?
  approvalStatus   ApprovalStatus @default(PENDING)

  requests         AmbulanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AmbulanceRequest {
  id                  String                 @id @default(cuid())
  status              AmbulanceRequestStatus @default(REQUESTED)

  patientId           String
  patient             Patient                @relation(fields: [patientId], references: [id])

  providerId          String?
  provider            AmbulanceProvider?     @relation(fields: [providerId], references: [id])

  latitude            Float?
  longitude           Float?
  address             String
  situationDescription String
  contactPhone        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id             String         @id @default(cuid())
  ticketNumber   Int            @default(autoincrement())
  subject        String
  category       TicketCategory
  status         TicketStatus   @default(OPEN)
  lastViewedByCreatorAt DateTime?
  satisfactionRating Int?

  createdById    String
  createdBy      Account        @relation("TicketsCreated", fields: [createdById], references: [id])

  assignedAgentId String?
  assignedAgent   Account?      @relation("TicketsAssigned", fields: [assignedAgentId], references: [id])

  messages       SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportMessage {
  id             String   @id @default(cuid())
  body           String
  attachmentUrl  String?

  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id])

  senderId       String
  sender         Account  @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())
}