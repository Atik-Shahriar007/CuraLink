generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  AMBULANCE_PROVIDER
  SUPPORT_AGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum ExperienceLevel {
  LESS_THAN_ONE
  ONE_TO_FIVE
  FIVE_PLUS
}

enum AmbulanceRequestStatus {
  REQUESTED
  ACCEPTED
  DISPATCHED
  ARRIVED
  COMPLETED
  CANCELED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  BILLING_AND_PAYMENTS
  TECHNICAL_ISSUE
  APPOINTMENT_PROBLEM
  AMBULANCE_ISSUE
  ACCOUNT_VERIFICATION
  PRESCRIPTION_ISSUE
  GENERAL_INQUIRY
  OTHER
}

// Doctor identity/license verification, separate from admin `approvalStatus`.
// Approval controls whether a doctor can appear/take bookings at all;
// verification is the extra "badge" tier confirming their license/ID was
// manually checked by an admin.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentCategory {
  LAB_REPORT
  PRESCRIPTION
  IMAGING
  VACCINATION
  OTHER
}

// ---------------------------------------------------------------------------
// Operations / maintenance enums
// ---------------------------------------------------------------------------

// What a user says is wrong. Deliberately worded from the reporter's point of
// view ("wrong information") rather than the engineer's ("data integrity bug"),
// because the reporter is a patient or a doctor, not a developer.
enum ReportCategory {
  BUG_GLITCH
  WRONG_INFORMATION
  PAYMENT_PROBLEM
  CONSULTATION_PROBLEM
  AMBULANCE_PROBLEM
  MEDICINE_CATALOG_PROBLEM
  MEDICAL_RECORD_PROBLEM
  OTHER
}

// Shared by issue reports and maintenance rules so a single severity scale and
// colour helper covers both consoles.
enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  NEW
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// Which portal the report came from. SYSTEM is reserved for reports the
// platform files about itself once auto-fix fails.
enum IssueSource {
  PATIENT
  DOCTOR
  PROVIDER
  SYSTEM
}

// The lifecycle of a maintenance work order, opened when a rule breaches and
// closed only once someone has verified the fix with their own eyes.
enum IncidentStatus {
  OPEN
  INVESTIGATING
  FIXED
  VERIFIED
  CLOSED
}

model Account {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  firstName         String?
  lastName          String?
  age               Int?
  phone             String?
  address           String?
  city              String?
  zipCode           String?
  role              Role
  isProfileCompleted Boolean @default(false)
  isActive          Boolean  @default(true)
  deactivatedAt     DateTime?
  emailNotifications Boolean @default(true)
  smsNotifications  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  doctor  Doctor?
  patient Patient?
  ambulanceProvider AmbulanceProvider?

  ticketsCreated    SupportTicket[]  @relation("TicketsCreated")
  ticketsAssigned   SupportTicket[]  @relation("TicketsAssigned")
  supportMessages   SupportMessage[]

  reportsFiled      IssueReport[]    @relation("ReportsFiled")
  reportsAssigned   IssueReport[]    @relation("ReportsAssigned")
  reportEvents      IssueReportEvent[]
  incidentsAssigned MaintenanceIncident[] @relation("IncidentsAssigned")
  incidentsVerified MaintenanceIncident[] @relation("IncidentsVerified")
}

model Doctor {
  id              String          @id @default(cuid())
  accountId       String          @unique
  account         Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  photoUrl        String?
  description     String?
  approvalStatus  ApprovalStatus  @default(PENDING)
  hospital        String?
  specialty       String?
  price           Float?
  degrees         String[]
  certifications  String[]
  schedule        Json?
  experienceLevel ExperienceLevel?

  // License/ID verification (badge shown to patients once VERIFIED)
  licenseNumber       String?
  licenseDocumentUrl  String?
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  verifiedAt          DateTime?
  verificationNote    String? // admin note, e.g. reason for rejection

  consultations   Consultation[]
  payments        Payment[]
  blogPosts       BlogPost[]
  reviews         Review[]
  prescriptions   Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id                    String   @id @default(cuid())
  accountId             String   @unique
  account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  photoUrl              String?
  weight                Float?
  height                Float?
  gender                Gender?
  bloodType             BloodType?
  allergies             String[]
  chronicConditions     String[]
  currentMedications    String[]
  emergencyContactName  String?
  emergencyContactPhone String?

  consultations Consultation[]
  payments      Payment[]
  ambulanceRequests  AmbulanceRequest[]
  reviews            Review[]
  prescriptions      Prescription[]
  medicalDocuments   MedicalDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A patient's personal health record store: uploaded lab reports, imaging,
// old prescriptions, vaccination cards, etc. Distinct from the structured
// allergy/condition/medication fields already on Patient, and from the
// per-consultation Prescription model written by doctors.
model MedicalDocument {
  id       String           @id @default(cuid())
  title    String
  category DocumentCategory @default(OTHER)
  fileUrl  String
  notes    String?

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model Consultation {
  id        String              @id @default(cuid())
  date      DateTime
  status    ConsultationStatus  @default(PENDING)
  notes     String?

  // Cancellation
  canceledAt         DateTime?
  cancellationReason String?
  canceledByRole     Role?

  doctorId  String
  doctor    Doctor              @relation(fields: [doctorId], references: [id])

  patientId String
  patient   Patient             @relation(fields: [patientId], references: [id])

  payment      Payment?
  review       Review?
  prescription Prescription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id                String        @id @default(cuid())
  checkoutSessionId String        @unique
  paymentIntentId   String?
  amount            Float
  currency          String        @default("usd")
  status            PaymentStatus @default(PENDING)

  // Refund tracking (set when a consultation is canceled after payment)
  stripeRefundId String?
  refundAmount   Float?
  refundReason   String?
  refundedAt     DateTime?

  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  consultationId String?       @unique
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id             String   @id @default(cuid())
  rating         Int
  comment        String?

  consultationId String   @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id])

  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medicine {
  id                    String   @id @default(cuid())
  brandName             String
  genericName           String
  form                  String
  therapeuticCategory   String
  // Null for catalog rows imported from medicines.sql, which carries no
  // manufacturer or clinical text. Curated entries still fill these in.
  manufacturer          String?
  strength              String
  unit                  String
  price                 Float
  prescriptionRequired  Boolean  @default(false)
  description           String?
  dosage                String?
  sideEffects           String?
  imageUrl              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandName])
  @@index([therapeuticCategory])
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  coverImageUrl String?
  excerpt       String?
  content       String
  category      String
  readTimeMinutes Int      @default(1)
  status        BlogStatus @default(DRAFT)
  rejectionReason String?

  doctorId      String
  doctor        Doctor     @relation(fields: [doctorId], references: [id])

  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model AmbulanceProvider {
  id               String         @id @default(cuid())
  accountId        String         @unique
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  photoUrl         String?
  organizationName String?
  vehicleInfo      String?
  serviceArea      String?
  licenseNumber    String?
  operatingHours   String?
  approvalStatus   ApprovalStatus @default(PENDING)

  requests         AmbulanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AmbulanceRequest {
  id                  String                 @id @default(cuid())
  status              AmbulanceRequestStatus @default(REQUESTED)

  patientId           String
  patient             Patient                @relation(fields: [patientId], references: [id])

  providerId          String?
  provider            AmbulanceProvider?     @relation(fields: [providerId], references: [id])

  latitude            Float?
  longitude           Float?
  address             String
  situationDescription String
  contactPhone        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prescription {
  id             String       @id @default(cuid())

  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  advice    String?
  // Bumped on every doctor edit so the patient portal can flag an update.
  revision  Int     @default(1)

  items     PrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id             String         @id @default(cuid())
  ticketNumber   Int            @default(autoincrement())
  subject        String
  category       TicketCategory
  status         TicketStatus   @default(OPEN)
  lastViewedByCreatorAt DateTime?
  satisfactionRating Int?

  createdById    String
  createdBy      Account        @relation("TicketsCreated", fields: [createdById], references: [id])

  assignedAgentId String?
  assignedAgent   Account?      @relation("TicketsAssigned", fields: [assignedAgentId], references: [id])

  messages       SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  name         String
  genericName  String?
  strengthForm String?
  category     String?

  // Free-text instruction the doctor writes per medicine, e.g.
  // "1 tablet twice daily after meals for 5 days".
  dosage       String

  // Set when the medicine is not in the bundled catalog, so the patient is told
  // to source it outside CuraLink.
  collectFromElsewhere Boolean @default(false)

  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([prescriptionId])
}

model SupportMessage {
  id             String   @id @default(cuid())
  body           String
  attachmentUrl  String?

  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id])

  senderId       String
  sender         Account  @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Operations: user-filed problem reports
// ---------------------------------------------------------------------------

// A user telling us something is wrong, anchored to the exact record they were
// looking at. The support ticket flow asks "how can we help you?"; this asks
// "what is broken and where", so the ops team gets a reproduction path instead
// of a conversation.
model IssueReport {
  id          String         @id @default(cuid())
  // Human-quotable number ("Your report #42"), shown to the reporter so they
  // can reference it without copying a cuid.
  reference   Int            @default(autoincrement())
  title       String
  description String
  category    ReportCategory
  severity    ReportSeverity @default(MEDIUM)
  status      ReportStatus   @default(NEW)
  source      IssueSource    @default(PATIENT)

  // Where the reporter was standing when they hit "Report a problem".
  // contextPath is the raw route and the entity pair is the structured anchor,
  // kept separate so we can both deep-link back and cluster repeats.
  contextPath     String?
  contextEntity   String?
  contextEntityId String?
  browserInfo     String?

  attachmentUrl   String?

  reporterId String
  reporter   Account @relation("ReportsFiled", fields: [reporterId], references: [id])

  assignedToId String?
  assignedTo   Account? @relation("ReportsAssigned", fields: [assignedToId], references: [id])

  resolutionNote String?
  resolvedAt     DateTime?

  events    IssueReportEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([contextEntity, contextEntityId])
}

// Append-only audit trail on a report: comments from either side plus the
// system's own status/assignment changes. Nothing is ever edited in place, so
// the reporter sees an honest history of what happened to their complaint.
model IssueReportEvent {
  id       String      @id @default(cuid())
  reportId String
  report   IssueReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  authorId String
  author   Account     @relation(fields: [authorId], references: [id])

  // "COMMENT" | "STATUS_CHANGE" | "ASSIGNMENT" | "SEVERITY_CHANGE"
  kind     String
  body     String
  // Set only for STATUS_CHANGE, so the timeline can render from -> to.
  fromValue String?
  toValue   String?

  createdAt DateTime @default(now())

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Operations: maintenance rules ("checks") and their work orders
// ---------------------------------------------------------------------------

// A standing question we ask about platform health, e.g. "are any consultations
// stuck past their start time?". The definition lives in the rule registry
// (src/lib/maintenance.ts); this row stores the operator-tunable parts
// (threshold, enabled) plus a denormalised cache of the last run so the console
// renders without replaying history.
model MaintenanceRule {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  description String
  area        String
  severity    ReportSeverity
  threshold   Int
  isEnabled   Boolean @default(true)

  lastRunAt      DateTime?
  lastValue      Int?
  // "OK" | "WARNING" | "BREACHED" | "ERROR"
  lastStatus     String?
  lastRunMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checks    MaintenanceCheck[]
  incidents MaintenanceIncident[]

  @@index([area])
}

// One sampled measurement of a rule. Kept as a series so the console can draw a
// trend and an operator can tell "this has been creeping up for a week" from
// "this spiked five minutes ago".
model MaintenanceCheck {
  id     String          @id @default(cuid())
  ruleId String
  rule   MaintenanceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  value   Int
  status  String
  message String?
  // A few offending record ids, so the UI can offer "jump to the broken thing"
  // rather than only a count.
  sampleIds String[]
  durationMs Int

  createdAt DateTime @default(now())

  @@index([ruleId, createdAt])
}

// A work order. Opened when a rule first breaches, owned by a person, and
// closed only after the fix has been independently verified - which is what
// makes MTTR a number worth showing.
model MaintenanceIncident {
  id     String          @id @default(cuid())
  ruleId String
  rule   MaintenanceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  status   IncidentStatus @default(OPEN)
  severity ReportSeverity
  title    String
  // Snapshot of the measurement that opened this incident, so the incident
  // stays readable even after the rule's live values change.
  openedValue Int
  peakValue   Int        @default(0)

  assigneeId String?
  assignee   Account? @relation("IncidentsAssigned", fields: [assigneeId], references: [id])

  rootCause      String?
  actionTaken    String?
  // Set when an auto-fix ran, naming the rule whose fixer was used.
  autoFixApplied Boolean @default(false)

  openedAt       DateTime  @default(now())
  acknowledgedAt DateTime?
  fixedAt        DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?

  verifiedById     String?
  verifiedBy       Account? @relation("IncidentsVerified", fields: [verifiedById], references: [id])
  verificationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ruleId, openedAt])
  @@index([openedAt])
}

